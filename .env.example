# Discord Application & Bot Credentials
# Obtain these from: https://discord.com/developers/applications

# Your Discord Application ID (from General Information tab)
APPLICATION_ID=your_discord_application_id

# Your Discord Bot Token (from Bot tab)
BOT_TOKEN=your_discord_bot_token

# Your Discord Public Key (from General Information tab, used for Ed25519 request verification)
DISCORD_PUBLIC_KEY=your_discord_public_key_hex
